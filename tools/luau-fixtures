#!/usr/bin/env python3
"""Turns each fixtures/hub/raw-*.json into a raw-*.luau twin (`return { ... }`).

`luau` has no file I/O, so tests read the twins. Null members are dropped, as tern.json.decode
drops them (a null array item is dropped too). Output is deterministic: keys keep JSON order.

    tools/luau-fixtures           write every twin
    tools/luau-fixtures --check   exit 1 when a twin is missing or stale, or when a query embedded in
                                  src/github.luau differs from its docs/hub/queries/*.graphql file
"""
import glob
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FIXTURES = os.path.join(ROOT, "fixtures", "hub")
QUERIES = os.path.join(ROOT, "docs", "hub", "queries")
GITHUB = os.path.join(ROOT, "src", "github.luau")
# `local <NAME>_QUERY = [=[ ... ]=]` in src/github.luau mirrors docs/hub/queries/<file>.graphql.
EMBEDDED = {"HUB": "hub-f", "THREADS": "threads", "CHECKS": "checks",
            "MERGE_DETECT": "merge-detect", "MERGE_FAILURE": "merge-failure", "DETAILS": "details"}
IDENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
KEYWORDS = {"and", "break", "do", "else", "elseif", "end", "false", "for", "function", "if", "in",
            "local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while", "continue"}


def string(text):
    out = ['"']
    for ch in text:
        if ch == '"':
            out.append('\\"')
        elif ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif ord(ch) < 32 or ord(ch) == 127:
            out.append("\\u{%x}" % ord(ch))
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def key(name):
    return name if IDENT.match(name) and name not in KEYWORDS else "[" + string(name) + "]"


def number(value):
    if isinstance(value, int):
        return str(value)
    return repr(value)


def literal(value, depth):
    pad = "\t" * (depth + 1)
    end = "\t" * depth
    if isinstance(value, dict):
        items = [(k, v) for k, v in value.items() if v is not None]
        if not items:
            return "{}"
        lines = [pad + key(k) + " = " + literal(v, depth + 1) + "," for k, v in items]
        return "{\n" + "\n".join(lines) + "\n" + end + "}"
    if isinstance(value, list):
        items = [v for v in value if v is not None]
        if not items:
            return "{}"
        lines = [pad + literal(v, depth + 1) + "," for v in items]
        return "{\n" + "\n".join(lines) + "\n" + end + "}"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return string(value)
    return number(value)


def twin(path):
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
    name = os.path.basename(path)
    return (
        "-- Generated by tools/luau-fixtures from " + name + ". Do not edit.\n"
        "return " + literal(data, 0) + "\n"
    )


def stale_queries():
    """Names of embedded queries that differ from their .graphql file."""
    with open(GITHUB, encoding="utf-8") as handle:
        source = handle.read()
    problems = []
    for name, file in EMBEDDED.items():
        match = re.search(r"local " + name + r"_QUERY = \[=\[\n(.*?)\]=\]", source, re.S)
        with open(os.path.join(QUERIES, file + ".graphql"), encoding="utf-8") as handle:
            wanted = "\n".join(l for l in handle.read().split("\n") if not l.startswith("#")).strip()
        if not match:
            problems.append("src/github.luau has no " + name + "_QUERY")
        elif match.group(1).strip() != wanted:
            problems.append("src/github.luau " + name + "_QUERY differs from docs/hub/queries/" + file + ".graphql")
    return problems


def main(argv):
    check = "--check" in argv
    problems = []
    for path in sorted(glob.glob(os.path.join(FIXTURES, "raw-*.json"))):
        out = path[: -len(".json")] + ".luau"
        wanted = twin(path)
        current = None
        if os.path.exists(out):
            with open(out, encoding="utf-8") as handle:
                current = handle.read()
        if check:
            if current != wanted:
                problems.append(os.path.relpath(out, ROOT) + (" is missing" if current is None else " is stale"))
        elif current != wanted:
            with open(out, "w", encoding="utf-8") as handle:
                handle.write(wanted)
            print("wrote " + os.path.relpath(out, ROOT))
    if check:
        if os.path.exists(GITHUB):
            problems += stale_queries()
        for problem in problems:
            print(problem, file=sys.stderr)
        if problems:
            print("run tools/luau-fixtures to regenerate", file=sys.stderr)
            return 1
        print("fixtures are current")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
